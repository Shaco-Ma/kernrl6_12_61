/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/input/input.h>
#include "rk3566.dtsi"

/ {
	model = "Shaco Dsb66";
	compatible = "shaco,dsb66", "rockchip,rk3566";

	aliases {
		//ethernet0 = &gmac1;
		mmc0 = &sdmmc0;
		mmc1 = &sdmmc1;
		mmc2 = &sdhci;
		rtc0 = &hym8563;
		rtc1 = &rk809;
	};

	chosen: chosen {
		//stdout-path = "serial2:1500000n8";
		bootargs = "androidboot.serialno=e3bbf55a7ff958e0 no_console_suspend rw rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0";
		//bootargs = "androidboot.serialno=fda8de96e2a5cc73  no_console_suspend rw rootwait earlycon=uart8250,mmio32,0xfe660000";
		//还是要加FIQ0
		//bootargs = "androidboot.serialno=fda8de96e2a5cc73  no_console_suspend rw rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 loglevel=7";
		//bootargs = "androidboot.serialno=fda8de96e2a5cc73  no_console_suspend rw rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 loglevel=7";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		//drm-logo@7df00000 {
		//	compatible = "rockchip,drm-logo";
		//	reg = <0x00 0x7df00000 0x00 0x20754c>;
		//};

		//drm-cubic-lut@7ff00000 {
		//	compatible = "rockchip,drm-cubic-lut";
		//	reg = <0x00 0x7ff00000 0x00 0x8000>;
		//};

		ramoops: ramoops@110000 {
			compatible = "ramoops";
			reg = <0 0x110000 0 0xf0000>;
			console-size = <0x80000>;
			ftrace-size = <0x00000>;
			pmsg-size = <0x50000>;
			record-size = <0x20000>;
		};
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <2>;
		//rockchip,signal-irq = <186>;
		rockchip,wake-irq = <0>;
		rockchip,irq-mode-enable = <1>;
		rockchip,baudrate = <115200>;
		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart2m0_xfer>;
		//status = "disabled";
		status = "okay";
	};

	//gmac1_clkin: external-gmac1-clock {
	//	compatible = "fixed-clock";
	//	clock-frequency = <125000000>;
	//	clock-output-names = "gmac1_clkin";
	//	#clock-cells = <0>;
	//};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	//leds {
	//	compatible = "gpio-leds";

	//	led-0 {
	//		gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
	//		function = LED_FUNCTION_HEARTBEAT;
	//		color = <LED_COLOR_ID_BLUE>;
	//		linux,default-trigger = "heartbeat";
	//		pinctrl-names = "default";
	//		pinctrl-0 = <&user_led2>;
	//	};
	//};

	dummy_codec: dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;
	};

	// I2S1 ---> PCM5102A
	dummy_sound: dummy-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,i2s1-dummy-codec";
		simple-audio-card,mclk-fs = <256>;
		hp-det-gpio = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;

		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&dummy_codec>;
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		//clocks = <&rk809 1>;
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reg_on_h>;
		//post-power-on-delay-ms = <100>;
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <5000000>;
		//reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	//这两个驱动都没有加进来.....
	debug: debug@fd904000 {
		compatible = "rockchip,debug";
		reg = <0x0 0xfd904000 0x0 0x1000>,
			<0x0 0xfd905000 0x0 0x1000>,
			<0x0 0xfd906000 0x0 0x1000>,
			<0x0 0xfd907000 0x0 0x1000>;
	};

	cspmu: cspmu@fd90c000 {
		compatible = "rockchip,cspmu";
		reg = <0x0 0xfd90c000 0x0 0x1000>,
			<0x0 0xfd90d000 0x0 0x1000>,
			<0x0 0xfd90e000 0x0 0x1000>,
			<0x0 0xfd90f000 0x0 0x1000>;
	};

	//一个是4 pc2,一个是4 pc3
	gpio-leds {
		compatible = "gpio-leds";

		sys_led: sys-led {
			label = "sys_led";
			linux,default-trigger = "heartbeat";
			default-state = "on";
			//gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
			gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&sys_led_pin>;
		};
	};

	//vcc5v_dcin: vcc5v-dcin-regulator {
	//	compatible = "regulator-fixed";
	//	regulator-name = "vcc5v_dcin";
	//	regulator-always-on;
	//	regulator-boot-on;
	//	regulator-min-microvolt = <5000000>;
	//	regulator-max-microvolt = <5000000>;
	//};
	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};


	vcc3v3_pcie: vcc3v3-pcie-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		//gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		gpios = <&gpio0 RK_PC2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		//pinctrl-0 = <&pcie_pwr_en>;
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <5000>;
		//vin-supply = <&vcc3v3_sys>;
		vin-supply = <&dc_12v>;
	};

	vcc3v3_sys: vcc3v3-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		//vin-supply = <&vcc5v0_sys>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_sys: vcc5v0-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		//vin-supply = <&vcc5v_dcin>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_usb30_host: vcc5v0-usb30-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		//gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb30_host_en>;
		regulator-name = "vcc5v0_usb30_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb20_host: vcc5v0-usb20-host-regulator {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb20_host_en>;
		regulator-name = "vcc5v0_usb20_host";
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;
	};

	//对应usb otg
	vcc5v0_usb_otg: vcc5v0-usb-otg-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		//gpio = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb_otg_en>;
		regulator-name = "vcc5v0_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;
	};

	//不需要了,如果需要控制cam的电源这里需要
	//vcc_cam: vcc-cam-regulator {
	//	compatible = "regulator-fixed";
	//	enable-active-high;
	//	gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
