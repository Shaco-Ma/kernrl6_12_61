	//	status = "okay";
	//};

	//gpio_keys: gpio-keys {
	//	status = "okay";
	//	compatible = "gpio-keys";

	//	headphone_det {
	//		debounce-interval = <100>;
	//		gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
	//		label = "headphone_det";
	//		linux,code = <KEY_KP0>;
	//	};
	//};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&mcu_ch32_en &pcm5102_smt_en>;
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <26000>;
		};
	};

	aimy_fan: aimy-fan {
		status = "okay";
		compatible = "aimy_fan";
		pwms = <&pwm4 0 10000000 0>;
	};

};

//&gic {
//		//compatible = "arm,gic-v3";
//		//#interrupt-cells = <3>;
//		#address-cells = <2>;
//		#size-cells = <2>;
//		ranges;
//		//interrupt-controller;
//
//		//reg = <0x0 0xfd400000 0 0x10000>,
//		//	  <0x0 0xfd460000 0 0xc0000>;
//		//interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
//		its: interrupt-controller@fd440000 {
//			compatible = "arm,gic-v3-its";
//			msi-controller;
//			#msi-cells = <1>;
//			reg = <0x0 0xfd440000 0x0 0x20000>;
//		};
//	};

&gic{
	compatible = "arm,gic-v3";
	reg = <0x0 0xfd400000 0 0x10000>, /* GICD */
	<0x0 0xfd460000 0 0x80000>; /* GICR */
	interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-controller;
	#interrupt-cells = <3>;
	mbi-alias = <0x0 0xfd410000>;
	mbi-ranges = <296 24>;
	msi-controller;
	ranges;
	#address-cells = <2>;
	#size-cells = <2>;
	dma-noncoherent;

	its: msi-controller@fd440000 {
		compatible = "arm,gic-v3-its";
		reg = <0x0 0xfd440000 0 0x20000>;
		dma-noncoherent;
		msi-controller;
		#msi-cells = <1>;
	};
};


