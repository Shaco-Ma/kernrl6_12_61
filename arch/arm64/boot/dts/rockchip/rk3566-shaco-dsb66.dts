	//不需要了,如果需要控制mipi的电源这里需要
	//vcc_mipi: vcc-mipi-regulator {
	//	compatible = "regulator-fixed";
	//	enable-active-high;
	//	gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
